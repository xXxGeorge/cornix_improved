/* Native ZMK adaptation of the active Kanata profile. See docs/kanata-zmk.md.
 * 50 logical positions, including encoder presses and auxiliary keys.
 */
#include "includes/cornix54.h"
#include "includes/kanata-timing.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include "includes/kanata-behaviors.dtsi"
#include "includes/kanata-combos.dtsi"

/* Kanata uses constant movement: 8 px/10 ms vertical, 12 px/10 ms horizontal.
 * HID/OS pointer acceleration can still change the observed pixel distance.
 */
&mmv {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};
&msc {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};
&mmv_input_listener {
    /* First match wins: fine overrides fast, regardless of press order.
     * 800 * 1/4 = 200 and 1200 * 1/6 = 200 approximate Kanata's
     * separately rounded 2 px/10 ms on both axes at 20% speed.
     */
    fine {
        layers = <MOUSE_FINE>;
        input-processors = <&zip_x_scaler 1 6>, <&zip_y_scaler 1 4>;
    };
    fast {
        layers = <MOUSE_FAST>;
        input-processors = <&zip_xy_scaler 2 1>;
    };
};

/ {
    behaviors {
        scroll_y: scroll_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        layer0 {
            display-name = "Base";
            bindings = <
                &kp TAB              &kp Q                &kp W                &kp E                &kp R                &kp T                &kp Y                &kp U                &kp I                &kp O                &kp P                &kp BSPC
                &nav_esc NAV ESC     &hm_l LALT A         &hm_l LCTRL S        &hm_l LSHFT D        &hm_l LGUI F         &kp G                &kp H                &hm_r RGUI J         &hm_r RSHFT K        &hm_r RCTRL L        &hm_r RALT SEMI      &kp RET
                &kp LSHFT            &kp Z                &kp X                &kp C                &kp V                &kp B                &kp K_MUTE           &kp C_PP             &kp N                &kp M                &kp COMMA            &kp DOT              &kp FSLH             &kp RSHFT
                &kp LCTRL            &td_num              &mo BT               &kp LSHFT            &sym_esc SYM ESC     &func_f13 FN F13              &kp BSPC              &kp SPACE            &kp RSHFT            &kp LEFT             &kp DOWN             &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer1 {
            display-name = "Number";
            bindings = <
                &none                &none                &none                &none                &none                &none                &kp LS(N2)           &kp KP_N7            &kp KP_N8            &kp KP_N9            &none                &none
                &nav_esc NAV ESC     &kp LS(MINUS)        &kp MINUS            &kp LS(EQUAL)        &kp EQUAL            &none                &kp KP_N0            &kp KP_NUMBER_4      &kp KP_NUMBER_5      &kp KP_N6            &kp DOT              &none
                &none                &none                &none                &none                &none                &none                &kp K_MUTE           &kp KP_NUMBER_4      &kp LS(MINUS)        &kp KP_N1            &kp KP_N2            &kp KP_N3            &none                &none
                &none                &none                &mo BT               &kp LSHFT            &sym_esc SYM ESC     &mo NAV              &kp BSPC              &kp SPACE            &kp RSHFT            &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer2 {
            display-name = "Windows";
            bindings = <
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &hm_l LGUI S         &trans               &hm_l LCTRL F        &trans               &trans               &hm_r RCTRL J        &trans               &hm_r RGUI L         &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer3 {
            display-name = "Symbols";
            bindings = <
                &kp TILDE            &kp EXCL             &kp AT               &kp HASH             &kp DLLR             &kp PRCNT            &kp CARET            &kp AMPS             &kp ASTERISK         &kp LPAR             &kp RPAR             &trans
                &nav_esc NAV ESC         &kp N1               &kp N2               &kp N3               &kp N4               &kp N5               &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &kp F13
                &kp GRAVE            &kp UNDER            &kp MINUS            &kp PLUS             &kp EQUAL            &kp DQT              &trans               &trans               &kp LEFT             &kp RIGHT            &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &word                &trans               &trans               &trans               &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer4 {
            display-name = "Function";
            bindings = <
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &kp F12              &kp F1               &kp F2               &kp F3               &kp F4               &kp F5               &kp F6               &kp F7               &kp F8               &kp F9               &kp F10              &kp F11
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer5 {
            display-name = "Navigation";
            bindings = <
                &trans               &msc MOVE_Y(-33)     &mmv MOVE_Y(-800)    &msc MOVE_Y(33)      &trans               &trans               &trans               &msc MOVE_X(-33)     &mkp MB2             &msc MOVE_X(33)      &trans               &trans
                &trans               &mmv MOVE_X(-1200)   &mmv MOVE_Y(800)     &mmv MOVE_X(1200)    &trans               &trans               &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &mo MOUSE_FINE       &mo MOUSE_FAST
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &mkp MB1             &trans               &trans               &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer6 {
            display-name = "Mouse Fast";
            bindings = <
                &trans               &msc MOVE_Y(-33)     &mmv MOVE_Y(-800)    &msc MOVE_Y(33)      &trans               &trans               &trans               &msc MOVE_X(-33)     &mkp MB2             &msc MOVE_X(33)      &trans               &trans
                &trans               &mmv MOVE_X(-1200)   &mmv MOVE_Y(800)     &mmv MOVE_X(1200)    &trans               &trans               &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &mo MOUSE_FINE       &mo MOUSE_FAST
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &mkp MB1             &trans               &trans               &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer7 {
            display-name = "Mouse Fine";
            bindings = <
                &trans               &msc MOVE_Y(-33)     &mmv MOVE_Y(-800)    &msc MOVE_Y(33)      &trans               &trans               &trans               &msc MOVE_X(-33)     &mkp MB2             &msc MOVE_X(33)      &trans               &trans
                &trans               &mmv MOVE_X(-1200)   &mmv MOVE_Y(800)     &mmv MOVE_X(1200)    &trans               &trans               &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &mo MOUSE_FINE       &mo MOUSE_FAST
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans               &mkp MB1             &trans               &trans               &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
        layer8 {
            display-name = "Bluetooth and Layers";
            bindings = <
                &none         &none  &none   &none  &none  &none                         &none     &none    &none    &none   &none  &none
                &bt BT_SEL 2  &none  &none   &none  &none  &none                         &to BASE  &to NUM  &none    &none   &none  &none
                &bt BT_SEL 1  &none  &none   &none  &none  &none  &kp K_MUTE  &kp KP_N9  &none     &to WIN  &to SYM  &to FN  &none  &none
                &bt BT_SEL 0  &none  &mo BT  &none  &none  &none                         &none     &none    &none    &none   &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_y>;
        };
    };
};
